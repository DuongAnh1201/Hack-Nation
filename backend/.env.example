# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173

# LLM providers used by OmniAgent (set hard spending caps on these keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Bright Data (optional: web search/scraping for agents)
BRIGHTDATA_API_TOKEN=

# Live lab (website section 06). Only on the machine that runs Omnigent with your Claude credentials.
# LAB_ALLOW_START=1 lets the website start runs; LAB_ACCESS_CODE protects starting and stopping.
LAB_ALLOW_START=
LAB_ACCESS_CODE=
# Omnigent's local server (default http://127.0.0.1:6767) and the runs folder (default <repo>/runs).
OMNIGENT_URL=
LAB_RUNS_DIR=
